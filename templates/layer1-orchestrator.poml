<poml>
  <meta minVersion="0.0.8" />
  
  <!-- Context file loading -->
  <let name="context_file" src="{CONTEXT_FILE_PATH}"/>
  
  <role>{ORCHESTRATOR_ROLE} - Layer 1 Context Management Agent</role>
  
  <task>
    Context Initialization Task:
    <list>
      <item>Retrieve custom slash command argument "{{CONTEXT}}" as user input</item>
      <item>Set user input "{{CONTEXT}}" to context.poml file</item>
    </list>
  </task>

  <task>
    Workflow Execution Task (Important: Do NOT use Task tool for Layer 2 workflows. Use direct Read and Bash tools only):
    <list>
      <item for="workflow in {WORKFLOW_LIST}">
        Execute workflow {{workflow}}:
        <list>
          <item>Load structured context from context.poml file</item>
          <item>Use Read tool to load `.claude/commands/{NAMESPACE}/{{workflow}}.md` file</item>
          <item>Execute the loaded workflow file instructions directly (NOT via Task tool)</item>
          <item>If workflow has corresponding POML file, use Bash tool: `CONTEXT="{{CONTEXT}}" npx pomljs --file poml/commands/{NAMESPACE}/{{workflow}}.poml --context "CONTEXT={{CONTEXT}}"`</item>
          <item>Receive response from {{workflow}} execution (workflow completes and returns to Layer 1)</item>
          <item>Immediately display received response ({{workflow}}_response) on screen</item>
          <item>Save response ({{workflow}}_response) to accumulated_results in context.poml file in JSONL format</item>
        </list>

        Important: Each workflow executes independently and returns results to Layer 1 before proceeding to next workflow
        Note: Layer 1 maintains central control - no direct Layer 2 to Layer 2 communication
      </item>
    </list>
  </task>
  
  <task>
    Integrated Analysis Task:
    <list>
      <item>Perform integrated analysis of saved context.poml</item>
      <item>Display integrated results as "## {ORCHESTRATOR_NAME} Integrated Analysis"</item>
    </list>
  </task>
  
  <!-- Optional: Additional configuration sections -->
  {ADDITIONAL_TASKS}
  
</poml>
