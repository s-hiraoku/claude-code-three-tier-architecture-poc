<poml>
  <meta minVersion="0.0.8" />
  
  <!-- Context file loading -->
  <let name="context_file" src="{CONTEXT_FILE_PATH}"/>
  
  <role>{ORCHESTRATOR_ROLE} - Layer 1 Context Management Agent</role>
  
  <task>
    Context Initialization Task:
    <list>
      <item>Retrieve custom slash command argument "{{CONTEXT}}" as user input</item>
      <item>Set user input "{{CONTEXT}}" to context.poml file</item>
    </list>
  </task>

  <task>
    Agent Execution Task:
    <list>
      <item for="agent in {AGENT_LIST}">
        Execute agent {{agent}}:
        <list>
          <item>Load structured context from context.poml file</item>
          <item>Read `{COMMAND_AGENT_PATH}` and execute with agent={{agent}}, context_file={CONTEXT_FILE_LOCATION}</item>
          <item>Receive response from {{agent}}</item>
          <item>Immediately display received response ({{agent}}_response) on screen</item>
          <item>Save response ({{agent}}_response) to accumulated_results in context.poml file</item>
        </list>

        Important: Display results at this point and complete output before proceeding to next agent or integrated analysis
        Note: Use conversation history for information transfer according to context specifications
      </item>
    </list>
  </task>
  
  <task>
    Integrated Analysis Task:
    <list>
      <item>Perform integrated analysis of saved context.poml</item>
      <item>Display integrated results as "## {ORCHESTRATOR_NAME} Integrated Analysis"</item>
    </list>
  </task>
  
  <!-- Optional: Additional configuration sections -->
  {ADDITIONAL_TASKS}
  
</poml>