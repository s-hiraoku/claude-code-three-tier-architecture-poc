<poml>
  <meta minVersion="0.0.8" />
  
  <!-- Context file loading -->
  <let name="context_file" src="{CONTEXT_FILE_PATH}"/>
  
  <role>{ORCHESTRATOR_ROLE} - Layer 1 Context Management Agent</role>
  
  <task>
    Context Initialization Task:
    <list>
      <item>Retrieve custom slash command argument "{{CONTEXT}}" as user input</item>
      <item>Set user input "{{CONTEXT}}" to context.poml file</item>
    </list>
  </task>

  <task>
    Workflow Execution Task (Using File-based Coordination):
    <list>
      <item for="workflow in {WORKFLOW_LIST}">
        Execute workflow {{workflow}}:
        <list>
          <item>Load structured context from context.poml file</item>
          <item>Call `agent-workflow` with parameters "{{workflow}}" using File-based Coordination method</item>
          <item>Receive response from {{workflow}}</item>
          <item>Immediately display received response ({{workflow}}_response) on screen</item>
          <item>Save response ({{workflow}}_response) to accumulated_results in context.poml file in JSONL format</item>
        </list>

        Important: Display results at this point and complete output before proceeding to next workflow or integration analysis
        Note: Use conversation history for information transfer according to context specification
      </item>
    </list>
  </task>
  
  <task>
    Integrated Analysis Task:
    <list>
      <item>Perform integrated analysis of saved context.poml</item>
      <item>Display integrated results as "## {ORCHESTRATOR_NAME} Integrated Analysis"</item>
    </list>
  </task>
  
  <!-- Optional: Additional configuration sections -->
  {ADDITIONAL_TASKS}
  
</poml>
